{
  "name": "@gds-platform/cdk-tagging",
  "version": "0.0.1",
  "team": "platform",
  "license": "MIT",
  "packageManager": "pnpm@10.26.0",
  "publishConfig": {
    "registry": "https://registry-prod-904690835784.d.codeartifact.eu-west-2.amazonaws.com/npm/registry-prod-repo/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gds-once/platform-pkg-tag.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && pnpm build:markers",
    "clean": "rm -rf dist",
    "build:markers": "node scripts/write-type-markers.cjs",
    "build:types": "tsc --noEmit",
    "test": "vitest run --config test/vitest.config.mts",
    "test:watch": "vitest --config test/vitest.config.mts",
    "prepublishOnly": "pnpm build",
    "spg": "cspell \"**/*.{txt,ts,md,tf,yaml}\""
  },
  "peerDependencies": {
    "aws-cdk-lib": "2.254.0",
    "constructs": "10.0.0"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "^5.0.31",
    "@cspell/eslint-plugin": "^10.2.0",
    "aws-cdk-lib": "2.254.0",
    "constructs": "10.6.0",
    "cspell": "^10.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
